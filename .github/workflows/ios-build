
name: Flutter iOS Unsigned IPA Build

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:

jobs:
  ios-build:
    runs-on: macos-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable

      - name: Install dependencies
        run: flutter pub get

      - name: Install CocoaPods
        run: |
          if [ -f ios/Podfile ]; then
            cd ios
            pod install
          fi

      - name: Build unsigned iOS app
        run: flutter build ios --release --no-codesign

      - name: Package unsigned IPA
        shell: bash
        run: |
          set -e

          APP_PATH="build/ios/iphoneos/Runner.app"
          IPA_DIR="$RUNNER_TEMP/ipa/Payload"
          IPA_PATH="$RUNNER_TEMP/Runner-unsigned.ipa"

          if [ ! -d "$APP_PATH" ]; then
            echo "ERROR: Runner.app not found"
            find build/ios -name "*.app" -print || true
            exit 1
          fi

          rm -rf "$RUNNER_TEMP/ipa"
          mkdir -p "$IPA_DIR"
          cp -R "$APP_PATH" "$IPA_DIR/Runner.app"

          cd "$RUNNER_TEMP/ipa"
          /usr/bin/zip -qry "$IPA_PATH" Payload

          test -s "$IPA_PATH"
          /usr/bin/unzip -t "$IPA_PATH"

          echo "IPA created: $IPA_PATH"

      - name: Upload unsigned IPA artifact
        uses: actions/upload-artifact@v4
        with:
          name: ios-unsigned-ipa
          path: ${{ runner.temp }}/Runner-unsigned.ipa
          if-no-files-found: error

      - name: Upload iOS app artifact
        uses: actions/upload-artifact@v4
        with:
          name: ios-unsigned-app
          path: build/ios/iphoneos/Runner.app
          if-no-files-found: error
